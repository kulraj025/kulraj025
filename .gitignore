# Local API cache — regenerated on every run, never commit stale data
.cache/
scripts/.cache/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# The 3D contribution action emits ~19 theme variants on every run. The README uses
# exactly one, so the rest stay untracked rather than adding megabytes of unused SVG
# to a profile repository's history every day. Generated by readme-extras.yml.
profile-3d-contrib/*
!profile-3d-contrib/profile-night-rainbow.svg